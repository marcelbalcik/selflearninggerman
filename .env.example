# Copy this file to .env and add your key to enable live, AI-generated texts.
# Without a key the app still runs and serves curated sample lessons.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the port (default 3000)
# PORT=3000

# Optional: an email raises the free MyMemory word-lookup rate limit.
# MYMEMORY_EMAIL=you@example.com
